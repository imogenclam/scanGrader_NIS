# Настройки для локального запуска и Docker Compose.
SG_OCR_KEY=
SG_OCR_FOLDER=
SG_OCR_MODEL=math-markdown
SG_OCR_REVISION=
SG_MODEL_URL=
SG_MODEL_KEY=
SG_MODEL_NAME=
# 1 при размещении за HTTPS-прокси. Для локального HTTP оставьте 0.
SG_SECURE_COOKIE=0
# Без SMTP коды лежат в SG_DATA_DIR/mail/*.eml на машине сервера.
# Порт 587 использует STARTTLS, 465 — TLS с начала соединения.
SG_SMTP_HOST=
SG_SMTP_PORT=587
SG_SMTP_FROM=
SG_SMTP_USER=
SG_SMTP_PASSWORD=
